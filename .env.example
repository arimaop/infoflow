# Включить SQL Server (если не задано — используется SQLite db.sqlite3)
DB_ENGINE=sqlite

# Имя базы данных (создай в SSMS заранее)
MSSQL_NAME=info_flow

# Экземпляр SQL Server Express
# Обычно это .\SQLEXPRESS
MSSQL_HOST=.\SQLEXPRESS

# Для Express обычно пусто
MSSQL_PORT=

# Если используешь SQL Login (не Windows Auth)
MSSQL_USER=
MSSQL_PASSWORD=

# Драйвер ODBC (установи Microsoft ODBC Driver 18 или 17)
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# Доп. параметры подключения
MSSQL_EXTRA_PARAMS=TrustServerCertificate=yes

